#!/usr/bin/env bash
# macOS-style "Low Battery" warnings at 20 % and 10 % while unplugged (a few KB of memory, checks once a minute).
# The 10 % one stays on screen until it's closed, as on a Mac.
BAT=$(ls -d /sys/class/power_supply/BAT* 2>/dev/null | head -1); [ -n "$BAT" ] || exit 0
exec 9>"${XDG_RUNTIME_DIR:-/tmp}/battery-warning.lock"; flock -n 9 || exit 0   # one copy per login
SID="${XDG_SESSION_ID:-}"
warned=100
while sleep 60; do
  # Stop with the login session (a loop like this outlives logout otherwise)
  [ -z "$SID" ] || loginctl show-session "$SID" -p State --value 2>/dev/null | grep -qE 'active|online' || exit 0
  # UPower's figure, the one the menu bar shows (this Mac's kernel "capacity" reads ~10 points lower)
  cap=$(upower -i "$(upower -e | grep -m1 BAT)" 2>/dev/null | awk '/percentage/{gsub(/[.,%].*/, "", $2); print $2}')   # "57.6%" -> 57
  [ -n "$cap" ] || cap=$(<"$BAT/capacity")
  st=$(<"$BAT/status")
  [ "$st" = Discharging ] || { warned=100; continue; }
  for lvl in 10 20; do
    [ "$cap" -le $lvl ] && [ $warned -gt $lvl ] || continue
    warned=$lvl
    case "${LANG:-}" in
      es*) t="Batería baja"; m="Queda $cap % de batería. Conecte el cargador pronto." ;;
      *)   t="Low Battery";  m="$cap% battery remaining. Plug in to a power outlet soon." ;;
    esac
    if [ $lvl = 10 ]; then   # stays until closed
      notify-send -u critical -t 0 -i battery-caution -a Battery "$t" "$m"
    else                     # goes away by itself after 10 s
      notify-send -u normal -t 10000 -i battery-caution -a Battery "$t" "$m"
    fi
    break
  done
done
